# Copy to .env (never commit it) and export the variables, for example: set -a; source .env; set +a
# Never put a real key in this file.

# Claude API (default provider). A key created for the lab, or a profile from "ant auth login".
ANTHROPIC_API_KEY=sk-ant-your-lab-key

# Optional provider switch: anthropic (default), anthropic-bedrock (Claude on Bedrock with the
# Anthropic SDK), bedrock (any Bedrock model with tool use, through the Converse API).
MODEL_PROVIDER=anthropic
# Required with anthropic-bedrock or bedrock: a Bedrock model id or inference profile id
# enabled in your account and Region.
BEDROCK_MODEL_ID=
AWS_REGION=eu-west-3

# Optional: prices of the model you run, in dollars per million tokens (default: the lesson's
# Claude Opus 5.5 prices). The --budget guardrail relies on them.
# PRICE_SHEET={"input": 0, "output": 0, "cache_write": 0, "cache_read": 0}

# Optional Converse settings, for models that do not support every feature:
# BEDROCK_CACHE_POINTS=false
# BEDROCK_STRICT_TOOLS=false
# BEDROCK_MAX_TOKENS=4096
