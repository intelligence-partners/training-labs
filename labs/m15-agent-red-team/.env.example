# Copy to .env (never commit it) and export the variables, for example: set -a; source .env; set +a
# Never put a real key in this file, and never real contact details in scenarios.json.

# Claude API (default provider). A key created for the lab, or a profile from "ant auth login".
ANTHROPIC_API_KEY=sk-ant-your-lab-key

# Optional provider switch, to replay the same bench on another model (step 7):
# anthropic (default), anthropic-bedrock (Claude on Bedrock with the Anthropic SDK),
# bedrock (any Bedrock model with tool use, through the Converse API).
MODEL_PROVIDER=anthropic
# Required with anthropic-bedrock or bedrock: the agent model, and optionally the D4 classifier model
# (defaults to BEDROCK_MODEL_ID). Use ids enabled in your account and Region.
BEDROCK_MODEL_ID=
BEDROCK_CLASSIFIER_MODEL_ID=
AWS_REGION=eu-west-3

# Optional Converse settings, for models that do not support every feature:
# BEDROCK_CACHE_POINTS=false
# BEDROCK_STRICT_TOOLS=false
# BEDROCK_MAX_TOKENS=2000

# Step 8 (optional): the guardrail created by infra/ (terraform -chdir=infra output guardrail_id).
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Optional: target another agent with the same bench (module:function, importable from PYTHONPATH).
# BANC_AGENT=agent:traiter
