# Copy to .env (never commit it) and export the variables, for example: set -a; source .env; set +a
# Never put real credentials in this file: use an AWS CLI profile (AWS_PROFILE) for the sandbox account.

AWS_PROFILE=sandbox
AWS_REGION=eu-west-3

# Step 6 / 11 / 12: prompt version of the run (v1 stable, v2 deliberately faulty).
PROMPT_VERSION=v1

# Model or inference profile id (the lesson's default: the EU geographic inference profile).
MODEL_ID=eu.anthropic.claude-opus-5-5

# Optional provider switch: anthropic-bedrock (default, AnthropicBedrock client, as in the lesson)
# or bedrock (boto3 Converse API, to replay the evaluation set on another Bedrock model family).
MODEL_PROVIDER=anthropic-bedrock

# Optional: Bedrock prices of the model you run, in dollars per million tokens
# (default: the Claude API prices for Opus 5.5 quoted in the lesson).
# PRICE_SHEET={"input": 0, "cache_write": 0, "cache_read": 0, "output": 0}

# Optional Converse settings, for models that do not support every feature:
# BEDROCK_CACHE_POINTS=false
# BEDROCK_STRICT_TOOLS=false
# BEDROCK_MAX_TOKENS=4096

# Set to false if another instrumentation already traces the SDK (spans appear twice).
# ANTHROPIC_OPEN_TELEMETRY=false
