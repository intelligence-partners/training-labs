# Copy to .env (git-ignored), adjust, then load it with:  set -a; . ./.env; set +a
# The API key is generated during step 1 and kept in .acme-api-key (git-ignored), never here.

AWS_REGION=eu-west-3
# AWS_PROFILE=my-sandbox-profile

# Model of the agent. AgentCore is model-agnostic: any inference profile whose model family is
# enabled in your account works (aws bedrock list-inference-profiles).
TF_VAR_model_id=eu.anthropic.claude-opus-5-5

# Prefix of the AgentCore resource names (Terraform default), also checked by cleanup.sh.
TF_VAR_project_name=supportlab
PROJECT_NAME=supportlab

# Filled from the acme-api stack (step 1): eval "$(./scripts/lab-env.sh)" sets it for you.
# TF_VAR_acme_api_url=https://<api-id>.execute-api.eu-west-3.amazonaws.com
# TF_VAR_acme_api_key is read from .acme-api-key: export TF_VAR_acme_api_key="$(cat .acme-api-key)"
