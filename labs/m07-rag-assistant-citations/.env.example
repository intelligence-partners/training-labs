# Lab m07 - copy to .env (never commit it) or export these variables in your shell.

# Claude API (lesson path). Or skip it and use a profile created with `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: where Hugging Face stores the two local models (default ~/.cache/huggingface).
# HF_HOME=

# Optional provider switch: anthropic (default) or bedrock.
# MODEL_PROVIDER=bedrock
# Required with MODEL_PROVIDER=bedrock: a model enabled in your AWS account that supports
# search result blocks with citations (Claude models on Bedrock).
# BEDROCK_MODEL_ID=
# Optional: the model for contextualiser.py (defaults to BEDROCK_MODEL_ID).
# BEDROCK_CONTEXT_MODEL_ID=
# AWS_REGION=eu-west-3
# AWS_PROFILE=
