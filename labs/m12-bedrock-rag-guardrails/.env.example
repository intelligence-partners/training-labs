# Copy to .env (git-ignored), adjust, then load it with:  set -a; . ./.env; set +a
# No secret is needed: the AWS CLI and Terraform use your usual AWS credentials.

AWS_REGION=eu-west-3
# AWS_PROFILE=my-sandbox-profile

# Model used by the scripts (step 0) and by the function (through Terraform).
# Any inference profile whose model family is enabled in your account works with Converse.
MODEL_ID=eu.anthropic.claude-opus-5-5
TF_VAR_model_id=eu.anthropic.claude-opus-5-5
# Anthropic-specific effort level; leave empty for another model family.
TF_VAR_model_effort=low

# Names checked by cleanup.sh (Terraform defaults).
LAB_NAME=lab-rag-rh
KB_NAME=kb-lab-rh
