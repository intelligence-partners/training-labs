# Step 6: ADOT settings for a collector-less span export to the X-Ray OTLP endpoint.
# Usage, from solution/ or starter/:  source ../otel.env
export OTEL_PYTHON_DISTRO=aws_distro
export OTEL_PYTHON_CONFIGURATOR=aws_configurator
export OTEL_TRACES_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
export OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://xray.${AWS_REGION:-eu-west-3}.amazonaws.com/v1/traces"
export OTEL_METRICS_EXPORTER=none
export OTEL_LOGS_EXPORTER=none
export OTEL_RESOURCE_ATTRIBUTES="service.name=agent-support-m14,deployment.environment=lab"
