# Copy to .env, adjust, then `set -a; source .env; set +a` before the lab commands.
# Never put access keys here: use an IAM Identity Center (aws configure sso) profile or a role.
AWS_PROFILE=formation
AWS_REGION=eu-west-3
# Root of the test organization: aws organizations list-roots --query 'Roots[0].Id' --output text
TF_VAR_root_id=r-xxxx
# Address that receives the budget alerts.
TF_VAR_budget_email=you@example.com
# Optional: creates the Identity Center permission sets (Identity Center must be enabled).
TF_VAR_enable_identity_center=false
