# Lab m05 - copy to .env (never commit it) or export these variables in your shell.

# Claude API (lesson path). Or skip it and use a profile created with `ant auth login`.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: lower the output ceiling to force a truncation (step 7). Default 16000.
# SYNTHESE_MAX_TOKENS=300

# Optional provider switch: anthropic (default) or bedrock.
# MODEL_PROVIDER=bedrock
# Required with MODEL_PROVIDER=bedrock: the id of a model enabled in your AWS account
# that supports PDF documents and structured output (see the Bedrock console).
# BEDROCK_MODEL_ID=
# AWS_REGION=eu-west-3
# AWS_PROFILE=
