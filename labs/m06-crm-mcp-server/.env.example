# Lab m06 - copy to .env (never commit it) or export these variables in your shell.

# Step 5: the lab token that protects the HTTP server. Generate one, never reuse a real secret:
#   export CRM_TOKEN="$(python -c 'import secrets; print(secrets.token_urlsafe(24))')"
CRM_TOKEN=

# Step 7: the public HTTPS URL printed by `cloudflared tunnel --url http://localhost:8000`.
CRM_PUBLIC_URL=https://<random-words>.trycloudflare.com

# Step 7: Claude API key for appel_connecteur.py (or a profile created with `ant auth login`).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: another data file than the one next to server.py.
# CRM_DATA=/absolute/path/to/crm_data.json

# Optional provider switch: MODEL_PROVIDER=bedrock runs bedrock_mcp_client.py instead of the connector.
# MODEL_PROVIDER=bedrock
# BEDROCK_MODEL_ID=          # a model enabled in your AWS account that supports tool use
# AWS_REGION=eu-west-3
# AWS_PROFILE=
